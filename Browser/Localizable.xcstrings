    },
    "These websites have stored data that can be used to track your browsing. Removing the data may reduce tracking, but may also log you out of websites or change website behavior." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos sitios web almacenaron datos que pueden usarse para rastrear tu actividad de navegación. Eliminarlos puede reducir el rastreo, pero también puede cerrar tu sesión en sitios web o cambiar su comportamiento."
          }
        }
